# Variables for Railway (Service -> Variables). Not read from a file.
# If you add Railway's MySQL service, reference its variables instead:
#   DB_HOST=${{MySQL.MYSQLHOST}}  DB_PORT=${{MySQL.MYSQLPORT}}
#   DB_NAME=${{MySQL.MYSQLDATABASE}}  DB_USER=${{MySQL.MYSQLUSER}}  DB_PASS=${{MySQL.MYSQLPASSWORD}}
# (or MYSQLHOST/MYSQLPORT/MYSQLDATABASE/MYSQLUSER/MYSQLPASSWORD directly).
DB_HOST=
DB_PORT=3306
DB_NAME=railway
DB_USER=root
DB_PASS=
APP_TIMEZONE=Asia/Manila
# APP_DEBUG=false
