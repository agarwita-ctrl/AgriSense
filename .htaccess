# =====================================================================
#  AgriSense - Apache configuration (XAMPP)
#
#  No absolute paths are used, so the project folder can be renamed or
#  moved anywhere under htdocs and the rules still apply.
# =====================================================================

Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # /api/... has its own front controller - leave it alone.
    RewriteRule ^api(/|$) - [L]

    # Application internals are never reachable over HTTP. Only index.php,
    # /assets, /docs and the API entry point are public.
    #
    # esp32/ is on this list because the sketch carries the Wi-Fi
    # credentials and the device API key: served as a static file it hands
    # both to anyone who asks.
    RewriteRule ^(config|includes|models|controllers|views|database|esp32)(/|$) - [F,L]

    # Real files and directories (assets, docs, the .ino sketch) are served
    # directly.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Everything else is a route for the front controller.
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Belt and braces for servers without mod_rewrite: never hand out a raw
# database dump, a log file, or firmware source. The .ino/.h/.cpp entries
# matter most - Apache has no handler for them, so without this rule it
# serves the sketch verbatim, API key and Wi-Fi password included.
<FilesMatch "\.(sql|log|ini|bak|ino|h|cpp|c|hpp)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "same-origin"
</IfModule>

# Long cache for fingerprinted assets (they are requested with ?v=mtime).
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>
